#!/usr/bin/env bash
# Thin launcher so `scuttle` works from any directory (preserves your cwd, which is
# the project a bare `scuttle` opens a session in).
#   symlink onto PATH:  ln -s "$PWD/bin/scuttle" ~/.local/bin/scuttle
# Resolve through symlinks so DIR points at the real repo, not the symlink's dir.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
exec "$DIR/node_modules/.bin/tsx" "$DIR/src/cli.ts" "$@"
