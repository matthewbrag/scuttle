{
  "name": "scuttle",
  "version": "0.0.1",
  "description": "Docker-native, model-agnostic autonomous coding-agent harness.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "server": "tsx src/server.ts",
    "scuttle": "tsx src/cli.ts",
    "tui": "tsx src/tui/index.tsx",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "express": "^4.21.2",
    "ink": "^5.1.0",
    "prismjs": "^1.30.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vite": "^8.3.4"
  }
}
